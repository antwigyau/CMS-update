# Church Management System — environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# EVERY variable in this file is SERVER-SIDE ONLY. None of them are sent to the
# browser: the frontend talks only to /api on its own origin, so there is no
# client-exposed variable list at all.

# ---------------------------------------------------------------------------
# Supabase — from Project Settings -> API in the Supabase dashboard
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Publishable / "anon" key. Safe for the server to hold; RLS still applies to it.
SUPABASE_ANON_KEY=

# Secret / "service_role" key. BYPASSES ROW LEVEL SECURITY.
# Never place this in any file under public/, never log it, never send it to the
# browser. Only modules on the allow-list in eslint.config.js may use it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public base URL of this deployment. Used for auth redirect links and for the
# Origin check that blocks cross-site requests. No trailing slash.
APP_URL=http://localhost:3000

# Prefix for session cookie names. Change it and every existing session is
# invalidated, which is occasionally useful.
SESSION_COOKIE_PREFIX=cma

# error | warn | info | debug
LOG_LEVEL=info
